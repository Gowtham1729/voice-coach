{
  "hosting": {
    "site": "ichido-511210",
    "public": "dist",
    "predeploy": [
      "node scripts/check-website.mjs",
      "node scripts/build-website.mjs"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|mjs|svg|png|jpg|jpeg|webp|avif|gif|ico|woff|woff2|ttf|otf|mp4|vtt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
